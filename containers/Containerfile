# syntax=docker/dockerfile:1.7
# Minimal multi-stage Containerfile for Managed AI (zero third-party runtime dependencies).

FROM python:3.12.9-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

COPY pyproject.toml LICENSE README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir setuptools==75.8.0 wheel==0.45.1 \
    && python -m pip wheel --no-deps --no-build-isolation -w /wheels .


FROM python:3.12.9-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MANAGED_AI_HOME=/var/lib/managed-ai

RUN groupadd --gid 10001 managed-ai \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/managed-ai --shell /usr/sbin/nologin --create-home managed-ai \
    && mkdir -p /var/lib/managed-ai \
    && chown -R 10001:10001 /var/lib/managed-ai

COPY --from=builder /wheels /wheels

RUN python -m pip install --no-cache-dir --no-deps /wheels/managed_ai-*.whl \
    && rm -rf /wheels

VOLUME ["/var/lib/managed-ai"]
WORKDIR /var/lib/managed-ai

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["managed-ai", "--help"]

ENTRYPOINT ["managed-ai"]
