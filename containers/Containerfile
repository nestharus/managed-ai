# syntax=docker/dockerfile:1.7
# Minimal multi-stage Containerfile for Managed AI Information (zero third-party runtime dependencies).

FROM python:3.15.2-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

COPY pyproject.toml LICENSE README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir setuptools==80.9.0 wheel==0.45.1 \
    && python -m pip wheel --no-deps --no-build-isolation -w /wheels .


FROM python:3.15.2-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MANAGED_AI_INFORMATION_HOME=/var/lib/managed-ai-information

RUN groupadd --gid 10001 managed-ai-information \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/managed-ai-information --shell /usr/sbin/nologin --create-home managed-ai-information \
    && mkdir -p /var/lib/managed-ai-information \
    && chown -R 10001:10001 /var/lib/managed-ai-information

COPY --from=builder /wheels /wheels

RUN python -m pip install --no-cache-dir --no-deps /wheels/managed_ai_information-*.whl \
    && rm -rf /wheels

VOLUME ["/var/lib/managed-ai-information"]
WORKDIR /var/lib/managed-ai-information

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["managed-ai-information", "--help"]

ENTRYPOINT ["managed-ai-information"]
